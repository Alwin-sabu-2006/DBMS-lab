create table items (itemid int  primary key, Itemname varchar(50), category_item varchar(30), Price int, Instock int check (Instock>=0));
create table Customers_1( custid int primary key, Custname varchar(30), Address varchar(30), state varchar(30));
create table orders_1(orderid  int primary key , Itemid int, Custid  int , Quantity int, Orderdate date,foreign key(itemid) references  items ,foreign key(custid) references  customers_1);
create table delivery(deliveryid int primary key, Custid  int , Orderid int  ,foreign key(orderid) references orders_1,foreign key(custid) references customer);
